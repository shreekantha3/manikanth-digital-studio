{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "python -m py_compile $file 2>&1 && echo 'Syntax OK'" }
        ]
      },
      {
        "matcher": "Write(*.py)|Edit(*.py)",
        "hooks": [
          { "type": "command", "command": "cd /Users/shree/Desktop/test_claude/x && python -m ruff check $file 2>&1 || echo 'Ruff not installed, skipping'" }
        ]
      },
      {
        "matcher": "Write(*.ts|*.tsx)|Edit(*.ts|*.tsx)",
        "hooks": [
          { "type": "command", "command": "npx tsc --noEmit --pretty false 2>&1 | head -20" }
        ]
      },
      {
        "matcher": "Write(*.rs)|Edit(*.rs)",
        "hooks": [
          { "type": "command", "command": "cargo check --message-format=short 2>&1 | head -20" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "cd /Users/shree/Desktop/test_claude/x && python -m pytest test_*.py -v 2>&1 | tail -20 || echo 'No tests found'" }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(**/.env*)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Write(**/.env*)",
      "Write(**/.ssh/**)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  }
}